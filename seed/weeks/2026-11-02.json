    "lax-limesmjor": {
      "name": "Landlax í limesmjöri með smælki og spergilkáli",
      "source": {
        "name": "Matseðill vikunnar"
      },
      "minutes": 30,
      "servings": 2,
      "tags": [
        "fiskur",
        "ofnréttur",
        "fljótlegt"
      ],
      "intro": "Allt fer í ofninn á 200 °C; kartöflurnar fara inn fyrst, laxinn og spergilkálið síðustu 15–20 mínúturnar.",
      "ingredients": [
        "1 pakki Landlax lax í limesmjöri, ca. 450 g",
        "5 litlar kartöflur úr lausu (ca. 400 g)",
        "ca. 250 g brokkólí (hálfur frosinn poki)",
        "Olía, salt og pipar"
      ],
      "steps": [
        "Hitið ofninn í 200 °C. Skerið kartöflurnar í tvennt, veltið upp úr olíu, salti og pipar og bakið í ca. 15 mínútur.",
        "Setjið laxinn í eldfast mót með smjörinu og brokkólíið með smá olíu á ofnplötuna hjá kartöflunum.",
        "Bakið allt saman í 15–20 mínútur, þar til laxinn flagnar auðveldlega í sundur. Fylgið tíma á umbúðum laxins ef hann er annar.",
        "Hellið limesmjörinu úr mótinu yfir kartöflurnar þegar borið er fram."
      ],
      "tip": "Afgangur af laxi er góður kaldur á brauð eða í salat daginn eftir.",
